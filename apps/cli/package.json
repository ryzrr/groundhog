{
  "name": "@groundhog/cli",
  "version": "0.1.0",
  "description": "Ink TUI — init, status, snap, pause, resume, block, unblock, history commands",
  "type": "module",
  "bin": {
    "groundhog": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@groundhog/daemon": "workspace:*",
    "@groundhog/shared": "workspace:*",
    "chalk": "^5.3.0",
    "clipboardy": "^5.3.1",
    "commander": "^12.1.0",
    "ink": "^4.4.1",
    "ink-text-input": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}
